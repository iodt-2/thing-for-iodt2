# Production ortam degiskenleri.
#
#   cp .env.example .env      (sunucuda, /opt/iodt2/ altinda)
#   chmod 600 .env
#
# .env GIT'E GIRMEZ — .gitignore'da zaten var.

# --- Imaj kaynagi ----------------------------------------------------------
# Imajlar sunucuda build edilir, registry kullanilmaz.
#   scripts/update.sh                 # pull + build + test + deploy
#   scripts/deploy.sh --build <TAG>   # etiketi elle vererek
# Imajlar "local/iodt2-backend:<TAG>" adiyla sadece bu makinede durur.
REGISTRY=local

# Calisan surumun etiketi. 'latest' KULLANMA — hangi kodun calistigini
# bilemezsin ve rollback yapamazsin. update.sh bunu commit SHA'sindan
# kendisi uretir; deploy.sh'i elle cagirirsan sen verirsin.
TAG=v1

# --- Fuseki ----------------------------------------------------------------
# stain/jena-fuseki bakimsiz; :latest KULLANMA, tekrarlanabilir olsun diye pinle.
FUSEKI_IMAGE=stain/jena-fuseki:3.17.0
FUSEKI_USERNAME=admin
# ZORUNLU. 'admin123' DEGIL — uzun rastgele bir sey uret:
#   openssl rand -base64 24
FUSEKI_PASSWORD=
FUSEKI_HEAP=2g

# --- Backend ---------------------------------------------------------------
BACKEND_WORKERS=4
# Kullanicinin tarayicida gordugu adres(ler), virgulle ayrilmis.
# Ornek: https://iodt2.sirket.local
CORS_ORIGINS=

# --- Frontend --------------------------------------------------------------
FRONTEND_PORT=3005
